GROQ_API_KEY=
# Compact code-review output budget (default: 1024; max 5 issues).
JARVIS_GROQ_CODE_REVIEW_MAX_TOKENS=1024
# Local code-review output budget only (default: 1536; allowed: 256-4096).
JARVIS_LOCAL_CODE_REVIEW_NUM_PREDICT=1536
GEMINI_API_KEY=
TAVILY_API_KEY=
JARVIS_ENABLE_DYNAMIC_SKILLS=
# Maximum total time for safe skill authoring and repair (default: 1200 seconds).
JARVIS_SKILL_AUTHORING_MAX_SECONDS=
# Maximum semantic SOURCE repairs after the initial proposal (default: 6).
JARVIS_SKILL_AUTHORING_MAX_SOURCE_REPAIRS=6
JARVIS_LOCAL_DEVICE_ID=
JARVIS_LOCAL_DEVICE_TOKEN=
# Faster-Whisper device (default: cpu)
JARVIS_WHISPER_DEVICE=
# Faster-Whisper compute type (default: int8 on CPU, float16 on CUDA)
JARVIS_WHISPER_COMPUTE_TYPE=
# Faster-Whisper CPU threads (default: 4)
JARVIS_WHISPER_CPU_THREADS=
# Faster-Whisper worker count (default: 1)
JARVIS_WHISPER_NUM_WORKERS=
# cpu = recomendado para reservar VRAM a Ollama; cuda = opcional para acelerar OCR.
JARVIS_OCR_DEVICE=cpu
